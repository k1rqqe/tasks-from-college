
n = int(input('Введите количество школьников: ')) # запрос данных у пользователя
k = int(input('Введите количество мандаринов: ')) # запрос данных у пользователя

print('Каждому школьнику достанется', k // n, 'мандаринов') # подсчёт и вывод результата
print('Останется в корзине', k % n, 'мандаринов') # подсчёт и вывод результата
